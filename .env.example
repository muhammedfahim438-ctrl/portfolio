# ========================================
# PORTFOLIO — ENVIRONMENT TEMPLATE
# ========================================
# Copy this file to `.env` in the project root and fill in the values.
#     cp .env.example .env           (Windows PowerShell: copy .env.example .env)
#
# `.env` is gitignored. Never commit real credentials.
# ========================================


# ========================================
# FIREBASE — WEB APP CONFIGURATION
# ========================================
# Firebase Console > Project Settings > General > Your apps > Web app
#
# These are *public client* credentials: they are inlined into the browser
# bundle by Vite. That is expected and safe for a Firebase Web app, but it
# means you must never put anything secret in a VITE_ variable.
# ========================================

# Firebase Web API key
VITE_FIREBASE_API_KEY=your-firebase-web-api-key

# Auth domain, e.g. your-project-id.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# Storage bucket, e.g. your-project-id.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Cloud Messaging sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Firebase Web app ID
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000


# ========================================
# ADMIN ACCOUNT
# ========================================
# The e-mail of the single admin account. It must match the Firebase Auth
# user that owns the /admin dashboard, and it is also the e-mail that
# firestore.rules allows to write content.
VITE_ADMIN_EMAIL=you@example.com

# Same account, used by `npm run seed` (scripts/seed.mjs) so the CLI seeder
# can sign in and write while firestore.rules restricts writes to signed-in
# users.
#
# NOTE: these are deliberately NOT prefixed with VITE_, so Vite never
# inlines them into the client bundle. They are read from process.env by a
# Node script only, and they never reach the browser.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-me


# ========================================
# FIREBASE APP CHECK (OPTIONAL)
# ========================================
# reCAPTCHA v3 site key from Firebase Console > App Check > your web app.
#
# Leave this EMPTY to skip App Check initialisation entirely (the default).
# Enabling *enforcement* is a console toggle — App Check > Apps > your web
# app > Enforcement — not a rules change.
#
# Note: reCAPTCHA v3 does not run in Node, so enforcing App Check on
# Firestore/Authentication will break `npm run seed`.
VITE_FIREBASE_APPCHECK_KEY=


# ========================================
# REMOVED — DO NOT RE-ADD
# ========================================
# SMTP_EMAIL and SMTP_APP_PASSWORD used to sit in .env but nothing in this
# repository reads them (there is no server-side mailer). Delete them from
# your local .env.
#
# If a Gmail app password was ever committed, pasted into a chat, or shared,
# revoke it in your Google account security settings and generate a new one.
